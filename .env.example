# ─── VYRO Digital Environment Variables ──────────────────────────────────────
#
# CONTACT FORM — Gmail SMTP (Nodemailer)
# ─────────────────────────────────────
# Requirements:
# 1. 2-Step Verification must be enabled on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character App Password under "Mail":
#    https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and 16-character App Password (without spaces) below:

GMAIL_USER=vyrodigital04@gmail.com
GMAIL_PASS=your_16_char_google_app_password
CONTACT_TO=vyrodigital04@gmail.com

# Canonical site URL used for Open Graph, metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
