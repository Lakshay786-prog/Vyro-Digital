# ─── VYRO Digital Environment Variables ──────────────────────────────────────
#
# CONTACT FORM — Resend Email API
# ───────────────────────────────
# Get your API key from https://resend.com/api-keys
# Add this environment variable in Render Dashboard -> Environment:
RESEND_API_KEY=re_your_resend_api_key_here

# Destination inbox for enquiries (defaults to vyrodigital04@gmail.com)
CONTACT_TO=vyrodigital04@gmail.com

# Canonical site URL used for Open Graph, metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
